{
  "name": "dsh-sidebar-expand-all",
  "version": "1.0.0",
  "description": "DSH 侧栏会话列表补丁：点一次「展开其余 N 个会话」就展开该工作区全部会话，「收起」严格回到 5 个。One-click expand-all for the DSH sidebar session list, with a strict collapse-to-5. · DeepSeek Harness 桌面版插件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./asar-patch": {
      "default": "./lib/asar-patch.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "skills",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "assets"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "sidebar",
    "sessions",
    "expand",
    "collapse",
    "asar",
    "patch"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
