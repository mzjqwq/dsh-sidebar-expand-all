{
  "name": "dsh-sidebar-expand-all",
  "version": "1.0.0",
  "description": "One-click expand-all for every remaining session in a DSH workspace, with a strict collapse-to-5.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mzjqwq/dsh-sidebar-expand-all.git"
  },
  "homepage": "https://github.com/mzjqwq/dsh-sidebar-expand-all#readme",
  "bugs": {
    "url": "https://github.com/mzjqwq/dsh-sidebar-expand-all/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./asar-patch": {
      "default": "./lib/asar-patch.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "skills",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "assets"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "sidebar",
    "sessions",
    "expand",
    "collapse",
    "asar",
    "patch"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
